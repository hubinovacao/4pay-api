# App
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=4pay
DB_SYNC=true

# URL pública do backend (Traefik). Usada para registrar notification_url nos gateways.
PUBLIC_BASE_URL=https://4pay.seu-dominio.com

# JWT
JWT_SECRET=troque-esta-string-em-producao
JWT_TTL_SECONDS=28800

# Chave mestra usada para cifrar (AES-256-GCM) credenciais de gateway em `integrations`.
# Pode ser qualquer string longa; é derivada para 32 bytes via SHA-256.
INTEGRATIONS_MASTER_KEY=troque-esta-chave-mestra-em-producao

# Super admin bootstrap (criado no startup se não existir).
SUPER_ADMIN_EMAIL=super@4pay.local
SUPER_ADMIN_SENHA=trocar-no-primeiro-login
